# ==============================================================================
# BarterHub PostgreSQL JDBC Configuration
# ==============================================================================

# Standard PostgreSQL Connection String (parsed automatically by DatabaseConnection.java)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/productexchange?schema=public"

# Explicit JDBC Parameters (Alternative direct specification)
JDBC_DATABASE_URL="jdbc:postgresql://localhost:5432/productexchange"
JDBC_USER="postgres"
JDBC_PASSWORD="password"

# Cloud Database Deployment Example (e.g. Neon, Supabase, AWS RDS):
# JDBC_DATABASE_URL="jdbc:postgresql://ep-example-pooler.us-east-2.aws.neon.tech/productexchange?sslmode=require"
# JDBC_USER="neondb_owner"
# JDBC_PASSWORD="your-strong-cloud-password"
