# PostgreSQL Database connection string
# Works with local PostgreSQL, Docker, Supabase, Neon, AWS RDS, etc.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/productexchange?schema=public"

# Authentication secret — use a random 32+ character string in production
JWT_SECRET="dev-super-secret-jwt-key-replace-in-production-random-32-chars"

# Public App URL (used for redirects and links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Upload storage provider (currently "local")
UPLOAD_STORAGE_PROVIDER="local"
